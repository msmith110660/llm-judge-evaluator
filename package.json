{
  "name": "llm-judge-evaluator",
  "version": "1.0.0",
  "description": "Browser-based LLM-as-judge tool for scoring LLM agent responses on relevance, tone, groundedness and system prompt adherence.",
  "author": "Marc Smith",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.marcsmith.llm-judge-evaluator",
    "productName": "LLM Judge Evaluator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "evaluator.html",
      "batch-runner.html"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LLM Judge Evaluator"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    }
  }
}
